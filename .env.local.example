DATABASE_URL=postgresql://user:password@ep-example-12345.eu-central-1.aws.neon.tech/neondb?sslmode=require

# Claus de Clerk (https://dashboard.clerk.com): crea una aplicació i activa
# Google com a proveïdor d'inici de sessió.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_canvia-això
CLERK_SECRET_KEY=sk_test_canvia-això
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
LEGACY_OWNER_EMAIL=el-teu-correu@exemple.cat,coworker@exemple.cat

# Clau de l'API de Google Places (https://console.cloud.google.com/google/maps-apis):
# crea un projecte, activa "Places API" i genera una clau. Sense això, el
# cercador de ciutats del formulari de grups no retorna cap resultat.
GOOGLE_MAPS_API_KEY=canvia-això

# URL pública de l'app (redireccions OAuth de xarxes socials i enllaços
# compartits). En local, http://localhost:3001.
NEXT_PUBLIC_APP_URL=https://escenari.app
# Protegeix els crons de Vercel (/api/cron/*): Vercel l'envia com a Bearer.
CRON_SECRET=canvia-això

# Xarxes socials del grup (Grup → Inici → Xarxes socials). Totes opcionals:
# sense claus, la xifra corresponent s'escriu a mà.
# · YouTube (subscriptors i visites): clau d'API de "YouTube Data API v3" a
#   https://console.cloud.google.com — no cal cap inici de sessió.
YOUTUBE_API_KEY=
# · Spotify (seguidors de l'artista): app a https://developer.spotify.com/dashboard.
#   Els oients mensuals es llegeixen de la pàgina pública, sense claus.
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
# · Instagram (seguidors, amb el compte del grup connectat): app a
#   https://developers.facebook.com amb el producte "Instagram" (API amb inici
#   de sessió d'Instagram), compte professional, i l'URI de redirecció
#   <NEXT_PUBLIC_APP_URL>/api/social/instagram/callback (ha de ser https).
INSTAGRAM_APP_ID=
INSTAGRAM_APP_SECRET=
# Pagaments (Stripe). Sense claus, tot funciona però no es pot contractar
# cap pla (els workspaces nous tenen 14 dies de prova amb tot inclòs).
# Preus: crea'ls al Dashboard (Grup mensual/anual, Agència S/M/L/XL
# mensual/anual, i "Membre fundador" com a pagament únic) i enganxa aquí
# els identificadors price_…
STRIPE_SECRET_KEY=sk_test_canvia-això
STRIPE_WEBHOOK_SECRET=whsec_canvia-això
STRIPE_PRICE_GRUP_MONTHLY=
STRIPE_PRICE_GRUP_YEARLY=
STRIPE_PRICE_AGENCIA_S_MONTHLY=
STRIPE_PRICE_AGENCIA_S_YEARLY=
STRIPE_PRICE_AGENCIA_M_MONTHLY=
STRIPE_PRICE_AGENCIA_M_YEARLY=
STRIPE_PRICE_AGENCIA_L_MONTHLY=
STRIPE_PRICE_AGENCIA_L_YEARLY=
STRIPE_PRICE_AGENCIA_XL_MONTHLY=
STRIPE_PRICE_AGENCIA_XL_YEARLY=
STRIPE_PRICE_FOUNDER=

# · TikTok (seguidors, amb el compte del grup connectat): app a
#   https://developers.tiktok.com amb Login Kit + Display API (scopes
#   user.info.basic i user.info.stats) i l'URI de redirecció
#   <NEXT_PUBLIC_APP_URL>/api/social/tiktok/callback.
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
